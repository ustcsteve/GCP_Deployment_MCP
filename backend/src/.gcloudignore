# Ignore local secrets and configuration files
.env
.env.*
.vscode/

# Ignore Git files
.git/
.gitignore

# Ignore heavy local dependencies (Docker will install these fresh inside the container)
node_modules/
__pycache__/
*.pyc
.venv/
venv/
bin/
obj/

# Ignore local build outputs and system files
.dockerignore
Dockerfile
dist/
build/
.DS_Store
